PORT=3000
NODE_ENV=development
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=banco_api

# Opcionais (valores padrão abaixo)
# Segundos sem enviar leitura até o ESP ser considerado offline
STATUS_ONLINE_SEGUNDOS=300
# Janela padrão do mapa de calor quando não vêm data_inicio/data_fim
MAPA_JANELA_MINUTOS=60
# Casas decimais da grade que agrupa os ESPs em localidades (2 ~ 1 km)
MAPA_PRECISAO_DECIMAIS=2
